{
  "variables": {
    "APP_URL": {
      "type": "url",
      "required": true,
      "description": "Public base URL"
    },
    "PORT": {
      "type": "port",
      "required": true
    },
    "NODE_ENV": {
      "type": "enum",
      "values": ["development", "test", "production"],
      "required": true
    },
    "ALERT_EMAIL": {
      "type": "email",
      "optional": true
    }
  }
}
